# terraform
.terraform/
.terraform-validate/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan
# Backend generado por `make bootstrap-migrate` (la plantilla backend.tf.example sí se versiona).
terraform/bootstrap/backend.tf
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Los módulos de terraform/modules/ no llevan lockfile: Terraform solo usa el de la raíz.
# `make validate-tf` genera uno local al hacer init.
terraform/modules/**/.terraform.lock.hcl

# Variables con valores reales (los *.tfvars.example sí se versionan).
# .terraform.lock.hcl SÍ se versiona: fija las versiones de los providers.
*.tfvars
*.tfvars.json
!*.tfvars.example

# entorno y credenciales
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.secret
*.secrets
secrets/
credentials.json
*-credentials.json
service-account*.json
*-sa-key*.json
application_default_credentials.json
# Lo escribe google-github-actions/auth en el workspace del runner.
gha-creds-*.json
# Configuración de Terraform CLI: puede llevar tokens de registro.
.terraformrc
terraform.rc
# Planes en JSON: incluyen valores sensibles en claro.
*.tfplan.json
plan.json

# herramientas
*.log
.trivy/

# IDEs
.vscode/
.idea/
*.swp

# Claude Code (config local)
.claude/
.mcp.json
opencode.json
.codegraph/
